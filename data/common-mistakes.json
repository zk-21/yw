        },
        {
          "错误": "找不到答案",
          "表现": "在文中乱找",
          "改善": "先看问题再读文章，带着问题找原文"
        },
        {
          "错误": "答而不全",
          "表现": "只答一问漏掉后续",
          "改善": "题干有几个问号就标序号，逐号回答"
        },
        {
          "错误": "用自己的话代替原文",
          "表现": "不引用原文",
          "改善": "先用原文关键句，再用自己的话补充"
        }
      ],
      "纠正策略": "审题三步：画关键词→标序号→先找原文再补充"
    },
    {
      "id": "writing_err",
