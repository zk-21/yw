    {
      "id": "grammar_err",
      "类别": "语法错误",
      "说明": "句型变换、关联词、病句",
      "年级范围": "3-6",
      "典型错误": [
        {
          "错误": "通过……使……（缺主语）",
          "正确句式": "删「通过」或「使」",
          "错误示例": "通过学习，使我提高了认识。",
          "正确示例": "学习使我提高了认识。"
        },
        {
          "错误": "关联词位置（主语相同时放主语后）",
          "正确规则": "他不仅学习好，而且体育好。",
          "错误示例": "不仅他学习好，而且他体育也好。"
        },
        {
          "错误": "搭配不当（穿着帽子）",
          "正确": "戴着帽子",
          "说明": "穿着搭配衣物，戴着搭配帽子/眼镜"
        },
        {
          "错误": "语义重复（减少不必要的浪费）",
          "正确": "减少浪费",
          "说明": "减少已含去不必要的之义"
        }
      ],
      "纠正策略": "先确认病因类型（残缺/搭配/语序/重复），再只改最小单元"
    },
    {
      "id": "reading_err",
      "类别": "阅读理解",
