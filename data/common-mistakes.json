      "典型错误": [
        {
          "错误": "感叹号放引号外",
          "正确": "「太棒了！」他说（引号内含感叹号）"
        },
        {
          "错误": "顿号逗号混淆",
          "正确规则": "顿号管词，逗号管句"
        },
        {
          "错误": "对话标点丢失",
          "正确格式": "提示语在前用冒号引号、提示语在后用句号"
        }
      ],
      "纠正策略": "每天找一处课文中的标点，说清为什么用这个标点而不用别的"
    }
