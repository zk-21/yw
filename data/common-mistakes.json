          "正确": "已经",
          "原因": "形近字混淆"
        },
        {
          "错误": "侯车室",
          "正确": "候车室",
          "原因": "笔画增减"
        },
        {
          "错误": "克苦",
          "正确": "刻苦",
          "原因": "同音字混淆"
        }
      ],
      "纠正策略": "同音字用组词区分，形近字用偏旁解析，易错字做拆字游戏"
