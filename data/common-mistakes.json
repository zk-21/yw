      "说明": "流水账、跑题、描写空洞、结构混乱",
      "年级范围": "2-6",
      "典型错误": [
        {
          "错误": "流水账",
          "表现": "事无巨细从头写到尾",
          "改善": "动笔前先想：最精彩的那个画面是什么？从那开始写"
        },
        {
          "错误": "跑题",
          "表现": "写着写着偏离主题",
          "改善": "写之前用一句话写出中心，写完后对照检查"
        },
        {
          "错误": "描写空洞",
          "表现": "只有「很漂亮」「很开心」",
          "改善": "用「五感法」：看到了什么、听到了什么、闻到了什么"
        },
        {
          "错误": "结构混乱",
          "表现": "没有开头结尾",
          "改善": "三段式：开头（点题）→中间（详写一件）→结尾（感受）"
        }
      ],
      "纠正策略": "不同问题不同方法——流水账练精彩瞬间、跑题练一句话中心、空洞练五感描写"
    },
    {
      "id": "pinyin_err",
      "类别": "拼音错误",
      "说明": "声调、前后鼻音、平翘舌、拼读规则",
      "年级范围": "1-2",
      "典型错误": [
        {
          "错误": "声调标错位置",
          "正确规则": "有a不放过，没a找oe，iu并列标在后"
        },
        {
          "错误": "前后鼻音混淆（in/ing）",
          "例子": "风（fēng）读成fēn"
        },
        {
          "错误": "平翘舌不分（z/zh）",
          "例子": "在（zài）读成zhài"
        },
        {
          "错误": "jqx后ü省两点但保留ü音",
          "正确": "jū（记住是j+ü但写ju）"
        }
      ],
      "纠正策略": "声调用手势辅助，鼻音用捏鼻子法感知，翘舌用卷舌动作"
    },
    {
      "id": "punctuation_err",
