      {
        "名称": "反问",
        "定义": "用疑问的形式表达确定的意思，答案就在问句中",
        "判断方法": "句子中有“难道”“吗”，答案是肯定的",
        "例子": [
          "难道这件事不是你做的吗？",
          "我们怎能忘记老师的教导？"
        ],
        "适用年级": 4,
        "易错点": [
          "否定词处理错误",
          "语气词忘记去掉"
        ]
      },
      {
        "名称": "排比",
        "定义": "把结构相同或相似、意思密切相关、语气一致的词语或句子成串地排列",
        "判断方法": "三个或以上结构相似的句子并列",
        "例子": [
          "书是钥匙，能开启智慧之门；书是阶梯，能帮助人们登上理想的高峰；书是良药，能医治愚昧之症。"
        ],
        "适用年级": 6,
        "易错点": [
          "结构不一致",
          "内容不相关"
        ]
      },
      {
        "名称": "夸张",
        "定义": "为了达到某种表达效果，对事物的形象、特征、作用、程度等方面着意夸大或缩小",
        "判断方法": "描述明显不符合实际情况",
        "例子": [
          "他饿得能吃下一头牛",
          "飞流直下三千尺"
        ],
        "适用年级": 6,
        "易错点": [
          "夸张过度不恰当",
          "分不清夸张和比喻"
        ]
      }
    ]
  },
  "句子基础": {
    "完整句": {
      "结构": "谁 + 做什么/是什么",
      "正例": "小明在跑步。",
      "错例": "在操场上。（缺主语）",
      "年级": 1
    },
    "四素句": {
      "结构": "什么时间 + 谁 + 在哪里 + 做什么",
      "正例": "早上，小明在学校操场上跑步。",
      "年级": 2
    },
    "四色检查法": "时间（蓝笔）→人物（红笔）→地点（绿笔）→事情（黑笔），四种颜色都有了，句子就不会缺胳膊少腿。"
  },
