    "description": "语法知识库",
    "itemCount": 7
  },
  "词性": {
    "实词": [
      {
        "名称": "名词",
        "定义": "表示人、事物、地点或抽象概念的名称",
        "判断方法": "前能加「一个」",
        "例子": [
          "学生",
          "书包",
          "学校",
          "快乐"
        ],
        "适用年级": 3
      },
      {
        "名称": "动词",
        "定义": "表示动作、行为、心理活动或存在变化",
        "判断方法": "前能加「正在」",
        "例子": [
          "跑",
          "看",
          "想",
          "有"
        ],
        "适用年级": 3
      },
      {
        "名称": "形容词",
        "定义": "表示事物的性质、状态或特征",
        "判断方法": "前能加「很」",
        "例子": [
          "美丽",
          "高兴",
          "认真",
          "可爱"
        ],
        "适用年级": 3
      },
      {
        "名称": "数词",
        "定义": "表示数量或顺序",
        "判断方法": null,
        "例子": [
          "一个",
          "两只",
          "三次",
          "第一次"
        ],
        "适用年级": 1
      },
      {
        "名称": "量词",
        "定义": "表示事物或动作的单位",
        "判断方法": null,
        "例子": [
          "个",
          "只",
          "次",
          "回"
        ],
        "适用年级": 1
      },
      {
        "名称": "代词",
        "定义": "表示人物称谓",
        "判断方法": null,
        "例子": [
          "我",
          "你",
          "他",
          "她"
        ],
        "适用年级": 1
      }
    ],
    "虚词": [
      {
        "名称": "副词",
        "定义": "修饰动词或形容词",
        "例子": [
          "非常",
          "已经",
          "忽然"
        ],
        "适用年级": 4
      },
      {
        "名称": "介词",
        "定义": "表示时间、地点、方式等",
        "例子": [
          "在",
          "从",
          "把"
        ],
        "适用年级": 4
      },
      {
        "名称": "连词",
        "定义": "连接词、短语或句子",
        "例子": [
          "和",
          "因为...所以",
          "虽然...但是"
        ],
        "适用年级": 4
      },
      {
        "名称": "助词",
        "定义": "附着在词后表示语法意义",
        "例子": [
          "的",
          "地",
          "得",
          "了",
          "着",
          "过"
        ],
        "适用年级": 6
      },
      {
        "名称": "叹词",
        "定义": "表示感叹、呼唤或应答",
        "例子": [
          "啊",
          "哦",
          "嗯"
        ],
        "适用年级": 6
      }
    ],
    "教学口诀": {
      "三字鉴定法": "名词前加「一个」、动词前加「正在」、形容词前加「很」",
      "虚实区分": "实词能独立站，虚词必须靠着别人"
    }
  },
  "标点符号": {
    "基础标点": [
      {
        "符号": "。",
        "名称": "句号",
        "规则": "陈述句末尾，一句话说完",
        "正例": "我是小学生。",
        "年级": 1
      },
      {
        "符号": "？",
        "名称": "问号",
        "规则": "疑问句末尾，提出问题",
        "正例": "你叫什么名字？",
        "年级": 1
      },
      {
        "符号": "！",
        "名称": "感叹号",
        "规则": "感叹句末尾，强烈感情",
        "正例": "春天真美啊！",
        "年级": 1
      },
      {
        "符号": "，",
        "名称": "逗号",
        "规则": "句子中间停顿",
        "正例": "春天来了，花儿开了。",
        "年级": 1
      },
      {
        "符号": "、",
        "名称": "顿号",
        "规则": "并列词语之间",
        "正例": "苹果、香蕉、橘子",
        "年级": 1
      }
    ],
    "进阶标点": [
      {
        "符号": "\"\"",
        "名称": "引号",
        "规则": "表示说的话或特别强调",
        "正例": "妈妈说：「早点睡觉。」",
        "年级": 2
      },
      {
        "符号": "：",
        "名称": "冒号",
        "规则": "用在说的话前面",
        "正例": "小华喊：「等等我！」",
        "年级": 2
      },
      {
        "符号": "……",
        "名称": "省略号",
        "规则": "省略或没说完的话",
        "正例": "我……我还没说完呢。",
        "年级": 2
      }
    ],
    "高级标点": [
      {
        "符号": "；",
        "名称": "分号",
        "规则": "分隔并列分句或长句",
        "年级": 5
      },
      {
        "符号": "——",
        "名称": "破折号",
        "规则": "解释说明、转折、声音延长",
        "年级": 5
      },
      {
        "符号": "《》",
        "名称": "书名号",
        "规则": "书籍、作品名称",
        "年级": 5
      }
    ],
    "小升初失分点": [
      "感叹号要放在引号里面：'太棒了！'他说",
      "并列词语用顿号，并列句子用逗号",
      "一个标点占一格"
    ],
    "教学口诀": {
      "标点记忆": "句号闭嘴、问号歪头、感叹号大喊——边读边做动作",
      "顿逗区分": "顿号管「词」、逗号管「句」"
    }
  },
  "句型变换": {
    "基础变换": [
      {
        "类型": "把字句",
        "格式": "谁 + 把 + 什么 + 怎么样",
        "正例": "我把作业写完了。",
        "年级": 2
      },
      {
        "类型": "被字句",
        "格式": "被动者 + 被 + 主动者 + 动作",
        "正例": "作业被我写完了。",
        "年级": 3
      },
      {
        "类型": "陈述句",
        "定义": "陈述事实，句末句号",
        "正例": "今天天气很好。",
        "年级": 3
      },
      {
        "类型": "疑问句",
        "定义": "提出问题，句末问号",
        "正例": "今天天气好吗？",
        "年级": 3
      },
      {
        "名称": "反问句改陈述句",
        "方法": "去掉“难道”“吗”，变问号为句号，否定变肯定",
        "例子": {
          "反问句": "难道这件事不是你做的吗？",
          "陈述句": "这件事是你做的。"
        },
        "适用年级": 4,
        "易错点": [
          "否定词处理错误",
          "语气词忘记去掉"
        ]
      },
      {
        "名称": "关联词运用",
        "方法": "根据句子关系选择合适的关联词",
        "常见关联词": [
          "因为...所以...",
          "虽然...但是...",
          "不但...而且...",
          "如果...就..."
        ],
        "适用年级": 4,
        "易错点": [
          "关联词搭配错误",
          "逻辑关系判断错误"
        ]
      },
      {
        "名称": "双重否定句",
        "方法": "用两个否定词表达肯定的意思",
        "常见否定词": [
          "不...不...",
          "没有...不...",
          "不可能不..."
        ],
        "例子": {
          "肯定句": "他一定知道这件事。",
          "双重否定句": "他不可能不知道这件事。"
        },
        "适用年级": 6,
        "易错点": [
          "否定词使用错误",
          "意思表达相反"
        ]
      },
      {
        "名称": "反问句改陈述句",
        "方法": "去掉“难道”“吗”，变问号为句号，否定变肯定",
        "例子": {
          "反问句": "难道这件事不是你做的吗？",
          "陈述句": "这件事是你做的。"
        },
        "适用年级": 4,
        "易错点": [
          "否定词处理错误",
          "语气词忘记去掉"
        ]
      },
      {
        "名称": "关联词运用",
        "方法": "根据句子关系选择合适的关联词",
        "常见关联词": [
          "因为...所以...",
          "虽然...但是...",
          "不但...而且...",
          "如果...就..."
        ],
        "适用年级": 4,
        "易错点": [
          "关联词搭配错误",
          "逻辑关系判断错误"
        ]
      },
      {
        "名称": "双重否定句",
        "方法": "用两个否定词表达肯定的意思",
        "常见否定词": [
          "不...不...",
          "没有...不...",
          "不可能不..."
        ],
        "例子": {
          "肯定句": "他一定知道这件事。",
          "双重否定句": "他不可能不知道这件事。"
        },
        "适用年级": 6,
        "易错点": [
          "否定词使用错误",
          "意思表达相反"
        ]
      }
    ],
    "进阶变换": [
      {
        "类型": "缩句",
        "口诀": "把「的」「地」「得」前面全删掉",
        "正例": "可爱的小狗→小狗；在公园里欢快地奔跑→奔跑",
        "年级": 4
      },
      {
        "类型": "扩句",
        "方法": "加定语→加状语→加补语→检查搭配",
        "正例": "小鸟唱歌→美丽的小鸟在树上欢快地唱歌",
        "年级": 4
      },
      {
        "类型": "肯定↔否定",
        "正例": "他是好学生→他不是坏学生",
        "年级": 5
      },
      {
        "类型": "陈述↔反问",
        "口诀": "加「难道……吗」",
        "正例": "应珍惜时间→难道不应该珍惜时间吗？",
        "年级": 5
      },
      {
        "类型": "直接↔间接引语",
        "要点": "改人称+去引号+改冒号为逗号",
        "正例": "妈妈说：「我今天不回家。」→妈妈说她今天不回家。",
        "年级": 5
      }
    ],
    "缩句铁律": "把'的''地''得'前面全删掉，'地'后面也删掉，剩下的就是主干。百试百灵。",
    "扩句铁律": "加完词后自己读一遍，别扭就说明搭配错了，换一个试试。"
  },
  "关联词": {
    "分类": [
      {
        "关系": "并列",
        "关联词": [
          "既……又……",
          "一边……一边……"
        ],
        "例句": "他既聪明又勤奋。",
        "年级": 2
      },
      {
        "关系": "递进",
        "关联词": [
          "不仅……而且……",
          "不但……还……"
        ],
        "例句": "他不仅学习好，而且乐于助人。",
        "年级": 5
      },
      {
        "关系": "转折",
        "关联词": [
          "虽然……但是……",
          "尽管……可是……"
        ],
        "例句": "虽然天气冷，但是他坚持锻炼。",
        "年级": 5
      },
      {
        "关系": "因果",
        "关联词": [
          "因为……所以……",
          "之所以……是因为……"
        ],
        "例句": "因为下雨，所以取消户外活动。",
        "年级": 5
      },
      {
        "关系": "假设",
        "关联词": [
          "如果……就……",
          "假如……就……"
        ],
        "例句": null,
        "年级": 5
      },
      {
        "关系": "条件",
        "关联词": [
          "只要……就……",
          "只有……才……"
        ],
        "例句": null,
        "年级": 5
      }
    ],
    "易错点": [
      {
        "描述": "关联词位置",
        "规则": "主语相同，关联词在主语后；主语不同，关联词在主语前",
        "正例": "他不仅学习好，而且体育也好。",
        "错例": "不仅他学习好，而且他体育也好。"
      },
      {
        "描述": "关联词堆砌",
        "规则": "一句话关联词不超过2组",
        "错例": "他不但语文学得好，而且数学也学得好，所以同学们都很佩服他，因此老师也经常表扬他。"
      }
    ]
  },
  "病句修改": {
    "常见类型": [
      {
        "病因": "成分残缺",
        "说明": "缺少主语、谓语或宾语",
        "病句": "在公园里玩。",
        "修改": "我在公园里玩。",
        "年级": 4
      },
      {
        "病因": "搭配不当",
        "说明": "词语之间搭配不合适",
        "病句": "我穿着漂亮的帽子。",
        "修改": "我戴着漂亮的帽子。",
        "年级": 4
      },
      {
        "病因": "语序颠倒",
        "说明": "词语顺序不对",
        "病句": "我把书包忘记在家里了。",
        "修改": "我忘记把书包放在家里了。",
        "年级": 4
      },
      {
        "病因": "重复累赘",
        "说明": "有多余的词",
        "病句": "他情不自禁地忍不住笑了起来。",
        "修改": "他情不自禁地笑了起来。",
        "年级": 6
      },
      {
        "病因": "表意不明",
        "说明": "有歧义",
        "病句": "我去上课。",
        "修改": "我去教室上课。",
        "年级": 6
      },
      {
        "病因": "不合逻辑",
        "说明": "前后矛盾",
        "病句": "所有的同学基本都到齐了。",
        "修改": "所有的同学都到齐了。",
        "年级": 6
      }
    ],
    "修改铁律": "只改出错的那个词或那个位置，其他地方原封不动。三道关：①意思一样②句子通顺③标点匹配。",
    "高危句式": [
      {
        "句式": "通过……使……",
        "问题": "必缺主语",
        "解法": "删「通过」或删「使」",
        "病句": "通过这次考试，使同学们更加重视了。",
        "修改": "这次考试使同学们更加重视了。"
      }
    ]
  },
  "修辞手法": {
    "基础修辞": [
      {
        "名称": "比喻",
        "定义": "用相似的事物打比方",
        "正例": "银杏叶像一把把小扇子。",
        "年级": 3
      },
      {
        "名称": "拟人",
        "定义": "把事物当作人来写",
        "正例": "月亮姑娘升起来了，正悄悄对小星星说着悄悄话。",
        "年级": 3
      },
      {
        "名称": "排比",
        "定义": "结构相似的句子并排使用",
        "正例": "有的跳绳，有的打球，有的跑步。",
        "年级": 4
      },
      {
        "名称": "夸张",
        "定义": "故意夸大或缩小特征",
        "正例": "他饿得能吃下一头牛。",
        "年级": 4
      },
      {
        "名称": "反问",
        "定义": "用疑问表达确定的意思",
        "正例": "难道我们不应该好好学习吗？",
        "年级": 4
      }
    ],
    "三层答题法": {
      "第一层": "是什么修辞",
      "第二层": "写出什么特点",
      "第三层": "表达什么情感/效果",
      "满分示例": "运用了比喻的修辞手法，将银杏叶比作小扇子，生动形象地写出了银杏叶的形状和秋风中飘落的动态美，表达了作者对秋天的喜爱之情。"
    },
    "常见修辞": [
      {
        "名称": "比喻",
        "定义": "用跟甲事物有相似点的乙事物来描写或说明甲事物",
        "判断方法": "有比喻词：像、好像、仿佛、似的",
        "例子": [
          "太阳像一个大火球",
          "弯弯的月亮像小船"
        ],
        "适用年级": 3,
        "易错点": [
          "分不清比喻和拟人",
          "比喻不当"
        ]
      },
      {
        "名称": "拟人",
        "定义": "把事物当作人来写，赋予事物人的动作和情感",
        "判断方法": "事物做出人的动作或表情",
        "例子": [
          "小鸟在树上唱歌",
          "花儿向我点头"
        ],
        "适用年级": 4,
        "易错点": [
