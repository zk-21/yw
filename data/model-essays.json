{
  "_meta": {
    "version": "2.0",
    "lastUpdated": "2026-05-25",
    "description": "范文方法库",
    "itemCount": 3
  },
  "作文类型": [
    {
      "类型": "写人",
      "说明": "通过具体事例表现人物特点",
      "3-4年级要素": [
        "外貌特征",
        "一个典型事例",
        "简单感受"
      ],
      "5-6年级要素": [
        "突出一个性格特点",
        "用2-3个事例或1个重点事例展开",
        "细节描写（动作/语言/神态/心理）"
      ],
      "常见问题": [
        "外貌描写面面俱到（只写最有特点的一两处）",
        "事例不典型（选最能体现品质的那件事）",
        "结尾只会「他真是一个好人」（从事件中自然引出感受）"
      ],
      "适用年级": "3-6年级"
    },
    {
      "类型": "记事",
      "说明": "按一定顺序写清一件事",
      "3-4年级要素": [
        "时间、地点、人物",
        "事情经过（详写一件事）",
        "结果+感受"
      ],
      "5-6年级要素": [
        "开头点题/设悬念",
        "详写精彩瞬间（用五感描写）",
        "穿插心理活动",
        "结尾升华感受"
      ],
      "常见问题": [
        "流水账（重点写最精彩的三五分钟）",
        "没感受（事情对你的触动就是独特感受）",
        "过程太笼统（把大动作拆成一系列小动作来写）"
      ],
      "适用年级": "3-6年级"
    },
    {
      "类型": "写景",
      "说明": "按顺序描写景物，表达情感",
      "3-4年级要素": [
        "选一处景物",
        "按顺序观察（从上到下/由近及远）",
        "抓住一个特点"
      ],
      "5-6年级要素": [
        "固定观察点/移步换景",
        "多感官描写（看+听+闻+触）",
        "情景交融（景中含情）"
      ],
      "常见问题": [
        "写景=罗列景点（只写最有感触的一两处深写）",
        "没有顺序（先确定观察路线再动笔）",
        "景和情分离（在写景句子里自然融入感受词）"
      ],
      "适用年级": "3-6年级"
    },
    {
      "类型": "状物",
      "说明": "描写物品的外形、功能、来历",
      "3-4年级要素": [
        "外形（颜色/形状/大小）",
        "功能或用途",
        "我喜欢它的原因"
      ],
      "5-6年级要素": [
        "外形+细节",
        "功能和故事",
        "托物言志（从物品中悟道理）"
      ],
      "常见问题": [
        "只写外形（要加上和它的故事才有温度）",
        "像说明书（加上你的感受和回忆）"
      ],
      "适用年级": "4-6年级"
    },
    {
      "类型": "想象作文",
      "说明": "展开合理想象创编故事",
      "3-4年级要素": [
        "设定角色和场景",
        "一个有趣的变化/事件",
        "回归现实的感悟"
      ],
      "5-6年级要素": [
        "新奇但合理的想象",
        "情节有波折",
        "想象背后有寓意"
      ],
      "常见问题": [
        "想象太离谱没逻辑（即使穿越也要有规则）",
        "情节平铺直叙（给主角设置一个困境再解决）"
      ],
      "适用年级": "4-6年级"
    },
    {
      "类型": "读后感",
      "说明": "读后感的写作框架",
      "要素": [
        "引——引出所读内容（一句话概括）",
        "议——最打动你的那一点",
        "联——联系生活或类似经历",
        "结——总结感悟"
      ],
      "常见问题": [
        "大段复述内容（一句话概括即可，重点是感受）",
        "感受空洞（联系一件具体的事来说）"
      ],
      "适用年级": "5-6年级"
    }
  ],
  "写作通用方法": [
    {
      "名称": "五感描写法",
      "内容": [
        "看到了什么（颜色/形状/动作）",
        "听到了什么（声音/节奏）",
        "闻到了什么（气味）",
        "摸到了什么（触感/温度）",
        "心里感觉到了什么（情绪）"
      ]
    },
    {
      "名称": "动作分解法",
      "内容": "把一个大动作拆成一系列小动作来写，如「他进门」→「他推开门，探头看了看，轻轻走了进来，随手带上了门」"
    },
    {
      "名称": "对比衬托法",
      "内容": "写变化前后对比、与其他事物对比，让特点更突出"
    },
    {
      "名称": "对话推进法",
      "内容": "用人物对话代替叙述，让文章更有画面感和节奏感"
    }
  ],
  "评分标准": {
    "20分制": {
      "一类文（18-20分）": "中心突出、内容具体、语言生动、结构完整",
      "二类文（14-17分）": "中心明确、内容较具体、语句通顺、结构较完整",
      "三类文（10-13分）": "中心基本明确、内容欠具体、语句基本通顺",
      "四类文（<10分）": "偏题、内容空洞、语言不通顺"
    }
  }
}